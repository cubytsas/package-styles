{
  "name": "@cubyt/style",
  "version": "1.2.0",
  "description": "Official Cubyt design system: tokens, themes, typography, layout scales, gradients, form styles, and brand assets",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cubytsas/package-styles.git"
  },
  "homepage": "https://github.com/cubytsas/package-styles#readme",
  "bugs": {
    "url": "https://github.com/cubytsas/package-styles/issues"
  },
  "type": "module",
  "sideEffects": [
    "./css/tokens.css",
    "./css/tailwind.css",
    "./css/brand.css",
    "./css/forms.css",
    "./css/base.css"
  ],
  "exports": {
    ".": "./css/tokens.css",
    "./tokens.css": "./css/tokens.css",
    "./base.css": "./css/base.css",
    "./tailwind.css": "./css/tailwind.css",
    "./brand.css": "./css/brand.css",
    "./forms.css": "./css/forms.css",
    "./assets/logo.svg": "./assets/logo.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "css/",
    "assets/logo.svg",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
